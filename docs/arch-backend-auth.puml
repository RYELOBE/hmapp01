@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 80
skinparam defaultFontSize 16
left to right direction

title 后端认证授权架构图

package "Spring Security 安全框架" {
    [请求过滤器] as filter
    [安全配置类] as config
    [安全上下文] as context
}

package "JWT 令牌管理" {
    [JWT 工具类] as jwtUtil
}

package "认证服务层" {
    [用户认证服务] as authService
    [运营认证服务] as opsService
    [密码编码器] as encoder
}

package "数据访问层" {
    [用户数据仓库] as userRepo
    [运营数据仓库] as opsRepo
}

package "数据库" {
    [(用户账号表)] as userTable
    [(运营账号表)] as opsTable
}

filter --> jwtUtil : 解析验证令牌
jwtUtil --> context : 设置认证信息

authService --> userRepo : 查询用户
userRepo --> userTable
authService --> encoder : 验证密码
authService --> jwtUtil : 生成令牌

opsService --> opsRepo : 查询运营账号
opsRepo --> opsTable
opsService --> jwtUtil : 生成运营令牌

config --> "登录/注册/商品列表\n圈子列表/字典接口" : 公开访问
config --> "其他所有接口" : 需认证访问

@enduml
