@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 80
skinparam defaultFontSize 16
left to right direction

title 文件上传模块设计图

package "前端组件层" {
    [图片上传组件] as uploader
}

package "后端服务层" {
    [上传控制器] as controller
    [上传服务] as uploadService
    [文件校验] as typeCheck
    [文件重命名] as rename
}

package "数据存储层" {
    [(上传文件表)] as fileTable
}

uploader --> controller
controller --> uploadService
uploadService --> typeCheck : 校验文件类型
uploadService --> rename : UUID重命名
typeCheck --> "文件类型: jpeg/png/gif/webp\n文件大小: 不超过5MB"
rename --> fileTable
fileTable --> "Base64编码存储\n文件元数据"

@enduml
