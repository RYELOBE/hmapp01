@startuml
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho

title 校园二手交易平台 - 卖家用例图

actor "卖家" as seller #B2EBF2

rectangle "卖家功能" {
    usecase "登录注册" as UC1
    usecase "发布商品" as UC2
    usecase "管理商品" as UC3
    usecase "查看订单" as UC4
    usecase "发货" as UC5
    usecase "处理退款" as UC6
    usecase "回复评价" as UC7
    usecase "数据统计" as UC8
    usecase "个人资料" as UC9
}

seller --> UC1
seller --> UC2
seller --> UC3
seller --> UC4
seller --> UC5
seller --> UC6
seller --> UC7
seller --> UC8
seller --> UC9

@enduml
