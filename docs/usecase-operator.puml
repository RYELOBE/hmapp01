@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8

title 校园二手交易平台 - 运营用例图

actor "运营" as operator

usecase "查看数据仪表盘" as UC1
usecase "商品审核" as UC2
usecase "评价审核" as UC3
usecase "圈子帖子审核" as UC4
usecase "圈子评论审核" as UC5
usecase "用户管理" as UC6
usecase "调整用户角色" as UC7
usecase "订单管理" as UC8
usecase "数据统计分析" as UC9
usecase "发送系统通知" as UC10
usecase "消息中心管理" as UC11

operator --> UC1
operator --> UC2
operator --> UC3
operator --> UC4
operator --> UC5
operator --> UC6
operator --> UC7
operator --> UC8
operator --> UC9
operator --> UC10
operator --> UC11

@enduml
