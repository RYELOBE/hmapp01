@startuml
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho

title 校园二手交易平台 - 运营用例图

actor "运营" as operator #E1BEE7

rectangle "运营功能" {
    usecase "后台登录" as UC1
    usecase "数据仪表盘" as UC2
    usecase "商品审核" as UC3
    usecase "评价审核" as UC4
    usecase "圈子审核" as UC5
    usecase "用户管理" as UC6
    usecase "订单管理" as UC7
    usecase "消息管理" as UC8
    usecase "审批工作台" as UC9
}

operator --> UC1
operator --> UC2
operator --> UC3
operator --> UC4
operator --> UC5
operator --> UC6
operator --> UC7
operator --> UC8
operator --> UC9

@enduml
