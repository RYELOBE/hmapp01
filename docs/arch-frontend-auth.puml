@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 80
skinparam defaultFontSize 16
left to right direction

title 前端认证状态管理图

package "网络请求" {
    [请求拦截器] as reqInterceptor
    [响应拦截器] as resInterceptor
    [错误处理] as error401
}

package "页面跳转" {
    [登录页面] as loginPage
    [首页] as homePage
    [无权限页面] as forbiddenPage
}

package "路由控制" {
    [路由守卫] as guard
    [权限校验] as permission
}

package "本地存储" {
    [LocalStorage] as storage
    [令牌缓存] as tokenCache
}

package "工具函数" {
    [令牌验证] as validate
    [过期检查] as expireCheck
}

package "Pinia 状态管理" {
    [认证状态仓库] as authStore
    [令牌状态] as tokenState
    [用户信息状态] as userState
    [角色信息状态] as rolesState
}

reqInterceptor -right-> "请求头注入" : 添加认证信息
reqInterceptor -down-> tokenCache : 获取令牌

resInterceptor -down-> error401 : 捕获401
error401 -right-> tokenCache : 清除令牌
error401 -down-> loginPage

storage -right-> tokenCache : 读取缓存
tokenCache -right-> authStore : 初始化认证状态

guard -down-> validate : 检查令牌存在性
guard -right-> expireCheck : 检查令牌有效性
guard -down-> permission : 校验用户角色
permission -right-> homePage : 有权限
permission -down-> forbiddenPage : 无权限

authStore -right-> tokenState
authStore -down-> userState
authStore -right-> rolesState

@enduml
