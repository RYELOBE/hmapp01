@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 140
skinparam ranksep 100
skinparam defaultFontSize 16
left to right direction

title 消息通知模块设计图

[消息中心组件] as msgCenter
[消息列表页面] as msgList

package "消息操作" {
    [标记已读] as markRead
    [删除消息] as deleteMsg
}

package "API 接口" {
    [列表/计数/最近通知] as api1
    [标记已读/删除通知] as api2
    [发送通知] as api3
}

package "后端服务层" {
    [通知控制器] as controller
    [通知服务] as service
}

[(通知消息表)] as notifTable

package "消息类型" {
    [系统通知] as sysMsg
    [交易消息] as tradeMsg
    [审核消息] as reviewMsg
    [互动消息] as interactMsg
}

msgCenter --> api1 : 获取未读计数\n最近5条消息
msgList --> api1 : 获取通知列表
msgList --> markRead : 标记已读
msgList --> deleteMsg : 删除消息
markRead --> api2
deleteMsg --> api2

api1 --> controller
api2 --> controller
api3 --> controller
controller --> service
service --> notifTable

service --> sysMsg : 审核结果
service --> tradeMsg : 订单变更
service --> reviewMsg : 评价审核
service --> interactMsg : 点赞评论

@enduml
