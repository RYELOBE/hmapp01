@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 80
skinparam defaultFontSize 16
left to right direction

title 数据字典模块设计图

package "前端常量定义" {
    [静态常量文件] as constants
    [商品分类常量] as itemCategory
    [成色选项常量] as condition
}

package "前端枚举管理" {
    [枚举配置文件] as enums
    [懒加载缓存] as cache
    [内存缓存] as memory
}

package "后端控制器层" {
    [字典控制器] as controller
    [数据查询服务] as queryService
}

package "数据库层" {
    [字典数据表] as dictTable
    [(字典项记录)] as dictRecord
}

package "字典数据类型" {
    [商品分类] as category
    [成色选项] as cond
    [用户状态] as userType
    [用户角色] as userRole
    [商品状态] as prodStatus
    [订单状态] as orderStatus
    [权限列表] as permList
}

constants --> itemCategory : 商品分类
constants --> condition : 成色选项

enums --> cache : 懒加载缓存
cache --> memory : 缓存到内存
memory --> enums : 后续直接返回

controller --> queryService : 数据查询
queryService --> dictTable : 查询字典表
dictTable --> dictRecord : 读取记录

dictRecord --> category : 商品分类
dictRecord --> cond : 成色选项
dictRecord --> userType : 用户状态
dictRecord --> userRole : 用户角色
dictRecord --> prodStatus : 商品状态
dictRecord --> orderStatus : 订单状态
dictRecord --> permList : 权限列表

@enduml
